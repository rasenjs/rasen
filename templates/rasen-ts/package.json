{
  "name": "rasen-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "yarn build:client && yarn build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server"
  },
  "dependencies": {
    "@rasenjs/compiler": "^0.1.0",
    "@rasenjs/core": "^0.1.8",
    "@rasenjs/html": "^0.1.4-alpha",
    "@rasenjs/reactive-signals": "^0.1.4-alpha",
    "@rasenjs/router": "^0.1.8-alpha",
    "@rasenjs/web": "^0.1.3-alpha",
    "express": "^4.18.2",
    "signal-polyfill": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
