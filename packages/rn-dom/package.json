{
  "name": "@rasenjs/rn-dom",
  "version": "0.2.0",
  "description": "React Native DOM abstraction layer for rasen",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elements": {
      "types": "./elements.d.ts",
      "import": "./elements.cjs",
      "require": "./elements.cjs"
    }
  },
  "files": [
    "dist",
    "elements.cjs",
    "elements.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn clean && yarn build"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "react-native": ">=0.76.0 <0.87.0"
  },
  "keywords": [
    "rasen",
    "react-native",
    "dom",
    "fabric",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rasenjs/rasen.git",
    "directory": "packages/rn-dom"
  },
  "homepage": "https://github.com/rasenjs/rasen/tree/main/packages/rn-dom",
  "bugs": {
    "url": "https://github.com/rasenjs/rasen/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "Rasen Contributors",
  "license": "MIT"
}
