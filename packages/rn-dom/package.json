{
  "name": "@rasenjs/rn-dom",
  "version": "0.1.0",
  "description": "React Native DOM abstraction layer for rasen",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "require": "./dist/elements.js"
    },
    "./tags": {
      "types": "./dist/elements.d.ts",
      "require": "./dist/elements.js"
    },
    "./register": {
      "types": "./register.d.ts",
      "require": "./dist/register.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/elements.ts --format cjs,esm --dts --external react-native --external @rasenjs/rn-dom && cp register.cjs dist/register.cjs && cp register.d.ts dist/register.d.ts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react-native --external @rasenjs/rn-dom --watch"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-native": "^0.76.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.76.0"
  }
}
