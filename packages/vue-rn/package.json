{
  "name": "@rasenjs/vue-rn",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 custom renderer for React Native Fabric via @rasenjs/rn-dom",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./dist/transformer/*": "./dist/transformer/*"
  },
  "typesVersions": {
    "*": {
      "router": [
        "./dist/router.d.ts"
      ],
      "dist/index": [
        "./dist/index.d.ts"
      ],
      "dist/router": [
        "./dist/router.d.ts"
      ],
      "dist/transformer/*": [
        "./dist/transformer/*"
      ]
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.transformer.json",
    "build:transformer": "tsc -p tsconfig.transformer.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vue/runtime-core": "^3.4.0"
  },
  "peerDependencies": {
    "@rasenjs/rn-dom": "workspace:*",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "transformer",
    "tags.d.ts"
  ]
}
