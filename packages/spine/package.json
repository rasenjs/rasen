{
  "name": "@rasenjs/spine",
  "version": "0.1.0-alpha",
  "description": "Rasen Spine runtime — self-developed, compatible with Spine JSON and DragonBones/LoongBones formats",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && ../../node_modules/.bin/tsup",
    "dev": "../../node_modules/.bin/tsup --watch",
    "test": "../../node_modules/.bin/vitest --run",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "spine",
    "dragonbones",
    "loongbones",
    "skeleton",
    "animation",
    "rasen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rasenjs/rasen.git",
    "directory": "packages/spine"
  },
  "homepage": "https://github.com/rasenjs/rasen/tree/main/packages/spine",
  "bugs": {
    "url": "https://github.com/rasenjs/rasen/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@rasenjs/assets": "workspace:*",
    "@rasenjs/core": "workspace:*",
    "@rasenjs/math": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
