{
  "name": "@rasenjs/web",
  "version": "0.1.3-alpha",
  "description": "Isomorphic web components with routing (exports DOM or HTML based on environment)",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/html.d.ts",
        "default": "./dist/html.js"
      },
      "browser": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "default": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      }
    },
    "./jsx-runtime": {
      "node": {
        "types": "./dist/jsx-runtime-ssr.d.ts",
        "default": "./dist/jsx-runtime-ssr.js"
      },
      "browser": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "default": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      }
    },
    "./jsx-dev-runtime": {
      "node": {
        "types": "./dist/jsx-runtime-ssr.d.ts",
        "default": "./dist/jsx-runtime-ssr.js"
      },
      "browser": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "default": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "../../node_modules/.bin/vitest --run",
    "typecheck": "../../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@rasenjs/dom": "workspace:*",
    "@rasenjs/html": "workspace:*",
    "@rasenjs/router-dom": "workspace:*",
    "@rasenjs/router-html": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
