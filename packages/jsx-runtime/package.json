{
  "name": "@rasenjs/jsx-runtime",
  "version": "0.1.6-alpha",
  "description": "Self-contained JSX runtime with host auto-detection for Rasen",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx": {
      "types": "./jsx.d.ts"
    }
  },
  "files": [
    "dist",
    "jsx.d.ts"
  ],
  "scripts": {
    "build": "yarn clean && ../../node_modules/.bin/tsup",
    "dev": "../../node_modules/.bin/tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rasen",
    "jsx",
    "tsx"
  ],
  "author": "Rasen Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@rasenjs/core": ">=0.1.0-alpha"
  }
}
