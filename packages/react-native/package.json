{
  "name": "@rasenjs/react-native",
  "version": "0.1.0-alpha",
  "description": "Rasen React Native renderer - Direct binding to RN Fabric architecture",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./metro": {
      "types": "./dist/metro/index.d.ts",
      "import": "./dist/metro/index.js",
      "require": "./dist/metro/index.cjs"
    },
    "./babel": {
      "types": "./dist/babel/index.d.ts",
      "import": "./dist/babel/index.js",
      "require": "./dist/babel/index.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js",
      "require": "./dist/devtools/index.cjs"
    },
    "./devtools/server": {
      "require": "./dist/devtools/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rasen-devtools": "./bin/rasen-devtools.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "../../node_modules/.bin/tsup --watch",
    "build": "yarn clean && ../../node_modules/.bin/tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react-native",
    "fabric",
    "renderer",
    "rasen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rasenjs/rasen.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/rasenjs/rasen/tree/main/packages/react-native",
  "bugs": {
    "url": "https://github.com/rasenjs/rasen/issues"
  },
  "author": "Rasen Contributors",
  "license": "MIT",
  "dependencies": {
    "@rasenjs/core": "workspace:^",
    "@rasenjs/rn-dom": "workspace:^"
  },
  "peerDependencies": {
    "react-native": ">=0.76.0 <0.87.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": false
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@rasenjs/reactive-vue": "workspace:^",
    "@types/babel__core": "^7.20.5",
    "@types/react-native": "^0.72.0",
    "vitest": "^1.6.1"
  }
}
