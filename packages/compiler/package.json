{
  "name": "@rasenjs/compiler",
  "version": "0.1.0",
  "description": "Rasen JSX static-hoisting compiler — bundler-agnostic (vite/webpack/rspack/esbuild via unplugin, Metro/RN via babel)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "require": "./dist/babel.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "../../node_modules/.bin/tsup --watch",
    "build": "yarn clean && ../../node_modules/.bin/tsup",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "test": "../../node_modules/.bin/vitest --run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/generator": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "unplugin": "^3.3.0"
  }
}
