{
  "name": "@rasenjs/examples-arpg",
  "version": "0.1.0",
  "description": "Sanctum — an isometric, touch-first action RPG slice built with Rasen (reactive canvas-2d + dom HUD)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && npx vercel deploy dist --prod --project arpg --archive=tgz",
    "assets:list": "../../node_modules/.bin/tsx tools/extract-original.ts list",
    "assets:extract": "../../node_modules/.bin/tsx tools/extract-original.ts extract"
  },
  "dependencies": {
    "@rasenjs/canvas-2d": "workspace:*",
    "@rasenjs/core": "workspace:*",
    "@rasenjs/dom": "workspace:*",
    "@rasenjs/reactive-signals": "workspace:*",
    "@rasenjs/vite-plugin-rasen": "workspace:*"
  },
  "devDependencies": {
    "@rasenjs/compiler": "workspace:*",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  }
}
