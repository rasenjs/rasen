{
  "name": "@rasenjs/examples-react-native",
  "version": "0.1.0",
  "description": "Rasen React Native examples - No React, direct Fabric binding",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "bundle:ios": "cd ../.. && npx metro build examples/react-native/index.js -O examples/react-native/bundle.ios.js -p ios",
    "bundle:android": "cd ../.. && npx metro build examples/react-native/index.js -O examples/react-native/bundle.android.js -p android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rasenjs/core": "workspace:*",
    "@rasenjs/react-native": "workspace:*",
    "@rasenjs/react-native-router": "workspace:*",
    "@rasenjs/reactive-vue": "workspace:*",
    "@rasenjs/router": "workspace:*",
    "@vue/reactivity": "^3.5.25",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/runtime": "^7.23.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
