{
  "name": "@rasenjs/examples-nikke-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone NIKKE character viewer built with @rasenjs/dom + unocss",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && npx vercel deploy dist --prod --project nikke-viewer --archive=tgz",
    "check:fit": "node probe-camera-timeline.mjs http://localhost:5191 webgl 25 cold",
    "check:fit:gpu": "node probe-camera-timeline.mjs http://localhost:5191 webgpu 25 cold",
    "check:fit:canvas": "node probe-camera-timeline.mjs http://localhost:5191 canvas 25 cold"
  },
  "dependencies": {
    "@rasenjs/assets": "workspace:*",
    "@rasenjs/canvas-2d": "workspace:*",
    "@rasenjs/core": "workspace:*",
    "@rasenjs/dom": "workspace:*",
    "@rasenjs/gfx": "workspace:*",
    "@rasenjs/reactive-vue": "workspace:*",
    "@rasenjs/router-dom": "workspace:*",
    "@vue/reactivity": "^3.5.25",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "unocss": "^66.0.0",
    "vite": "^5.0.7"
  }
}
