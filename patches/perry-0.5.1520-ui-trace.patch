+/// Log a reparenting operation when `PERRY_UI_TRACE` is set.
+///
+/// The host hands the renderer one view pointer and keeps presenting into it, so
+/// a view that gets moved into a different container afterwards still reports a
+/// live window and successful presents while the picture is scaled into whatever
+/// size the new container has. Which of these four functions did the move is the
+/// only thing that needs establishing.
+fn ui_trace(op: &str, parent: i64, child: i64) {
+    if std::env::var_os("PERRY_UI_TRACE").is_some() {
+        eprintln!("[reparent] {op} parent_handle={parent} child_handle={child}");
+    }
+}
