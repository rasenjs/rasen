+        invoke_wait_driver_fast();
         let microtasks = js_promise_run_microtasks();
         js_run_stdlib_pump();
         microtasks
     }
 }
 
+/// Drive one bounded turn of native async work (fetch / net / ws / timers that
+/// live in the tokio runtime).
+///
+/// Exists for hosts that drive their own run loop and therefore never call
+/// [`js_wait_for_event`] — perry-ui-macos's ~8 ms `NSTimer` pump is the case
+/// that motivated it. Such a host MUST call this every tick: `js_run_stdlib_pump`
+/// (which it already calls) only drains resolutions that have been queued, and in
+/// the unified single-thread async model nothing else on that path advances the
+/// runtime, so every native request stays pending forever.
+///
+/// No-ops cheaply (a single atomic load) when no wait-driver is registered or
+/// nothing native is in flight, so it is safe unconditionally.
+#[no_mangle]
+pub extern "C" fn perry_drive_native_tasks() {
+    invoke_wait_driver_fast();
+}
+
