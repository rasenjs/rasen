{
  "name": "benchmark-gfx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gfx renderer safety net: golden-image render lock + GL call/frame-time baseline probe for the WebGL2 perf refactor",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "vite build",
    "golden": "node golden.mjs",
    "golden:update": "node golden.mjs --update",
    "probe": "node probe-gl-stats.mjs",
    "probe:baseline": "node probe-gl-stats.mjs --baseline",
    "ab": "node ab.mjs"
  },
  "dependencies": {
    "@rasenjs/core": "file:../../packages/core",
    "@rasenjs/gfx": "file:../../packages/gfx",
    "@rasenjs/reactive-vue": "file:../../packages/reactive-vue"
  },
  "devDependencies": {
    "pixelmatch": "^7.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.32.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
