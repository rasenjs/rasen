{
  "name": "benchmark-spine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spine rendering benchmark: Rasen vs official spine-ts vs pixi-spine (identical skeleton, identical protocol, canvas-vs-canvas / webgl-vs-webgl)",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "vite build",
    "preview": "vite preview --port 5177",
    "start": "node ../scripts/start-server.mjs",
    "verify": "node verify-render.mjs",
    "bench": "node bench.js",
    "bench:no-headless": "node bench.js --no-headless"
  },
  "dependencies": {
    "@esotericsoftware/spine-canvas": "4.1.56",
    "@esotericsoftware/spine-core": "4.1.56",
    "@esotericsoftware/spine-webgl": "4.1.56",
    "@rasenjs/assets": "file:../../packages/assets",
    "@rasenjs/canvas-2d": "file:../../packages/canvas-2d",
    "@rasenjs/core": "file:../../packages/core",
    "@rasenjs/dom": "file:../../packages/dom",
    "@rasenjs/gfx": "file:../../packages/gfx",
    "@rasenjs/reactive-vue": "file:../../packages/reactive-vue",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "pixelmatch": "^7.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.32.0",
    "terser": "^5.31.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
