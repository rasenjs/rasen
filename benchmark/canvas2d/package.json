{
  "name": "benchmark-canvas2d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Canvas 2D rendering benchmark: Rasen vs Vanilla vs Konva vs Fabric (identical scene, identical protocol)",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "start": "node ../scripts/start-server.mjs",
    "bench": "node bench.js",
    "bench:no-headless": "node bench.js --no-headless"
  },
  "dependencies": {
    "@rasenjs/canvas-2d": "workspace:*",
    "@rasenjs/core": "workspace:*",
    "@rasenjs/dom": "workspace:*",
    "@rasenjs/reactive-vue": "workspace:*",
    "fabric": "^6.0.2",
    "konva": "^9.3.20"
  },
  "devDependencies": {
    "pixelmatch": "^7.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.32.0",
    "terser": "^5.31.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
